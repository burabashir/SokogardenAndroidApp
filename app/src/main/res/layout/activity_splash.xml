<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient_background">

    <!-- Floating background elements container -->
    <FrameLayout
        android:id="@+id/floating_elements_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main content container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:elevation="10dp">

        <!-- Logo/Icon Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/logo_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="24dp"
            app:cardElevation="16dp"
            android:layout_marginBottom="48dp">

            <RelativeLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@android:color/white"
                android:padding="32dp">

                <!-- Main Sprout Icon -->
                <ImageView
                    android:id="@+id/icon_sprout"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_sprout"
                    android:tint="@color/emerald_600"
                    android:contentDescription="@string/sprout_icon" />

                <!-- Flower Icon (animated) -->
                <ImageView
                    android:id="@+id/icon_flower"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_flower"
                    android:tint="@color/pink_500"
                    android:contentDescription="@string/flower_icon" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <!-- Title Section -->
        <LinearLayout
            android:id="@+id/title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0"
            android:layout_marginBottom="48dp">

            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="56sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/emerald_600"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/app_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textSize="18sp"
                android:textColor="@color/slate_600"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- Loading Indicator -->
        <LinearLayout
            android:id="@+id/loading_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:alpha="0">

            <View
                android:id="@+id/dot1"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/loading_dot"
                android:layout_marginEnd="8dp" />

            <View
                android:id="@+id/dot2"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/loading_dot"
                android:layout_marginEnd="8dp" />

            <View
                android:id="@+id/dot3"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/loading_dot" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom decoration -->
    <View
        android:id="@+id/bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bottom_gradient"
        android:alpha="0" />

</RelativeLayout>